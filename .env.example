# HTTP port the API listens on.
PORT=3000
# development, test or production.
NODE_ENV=development
# Log level: fatal, error, warn, info, debug.
LOG_LEVEL=info

# PostgreSQL connection (docker compose sets these for the api service).
# TLS to the database: disable, require or verify-full (verify-full required in production).
DB_SSL=disable
# CA certificate file for verify-full.
DB_SSL_CA=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=borderless
DB_USER=borderless
# Local placeholder only. Use a real secret anywhere shared.
DB_PASSWORD=change-me

# FX sources (no keys needed). Primary first, secondary if it fails.
FX_PRIMARY_URL=https://open.er-api.com/v6/latest/USD
FX_SECONDARY_URL=https://latest.currency-api.pages.dev/v1/currencies/usd.json
# Rates older than this, from the provider's update time, never price swaps or transfers.
FX_MAX_DATA_AGE_HOURS=26
# Provider request timeout, in milliseconds.
FX_TIMEOUT_MS=3000
# Use the built-in fixed table when both live sources fail (offline demos only).
FX_FIXED_TABLE=false

# Folder of ES256 private keys named <kid>.pem (git-ignored). Development makes one on first start.
JWT_KEYS_DIR=./keys/jwt
# Key ID that signs new access tokens.
JWT_ACTIVE_KID=dev-1
# Token issuer and audience checked on every request.
JWT_ISSUER=borderless
JWT_AUDIENCE=borderless-api
# Access-token lifetime, in minutes.
JWT_ACCESS_MINUTES=15
# Refresh-token lifetime, in days.
REFRESH_TOKEN_DAYS=30

# Comma-separated browser origins allowed by CORS. Empty means CORS is off.
CORS_ORIGINS=
# Requests per minute per IP.
RATE_LIMIT_PER_MINUTE=120

# Email and phone encryption keys: version:base64 of 32 random bytes, comma-separated.
# Generate one with: openssl rand -base64 32
PII_ENCRYPTION_KEYS=1:replace-with-base64-32-bytes
# Key version used for new writes.
PII_ACTIVE_KEY_VERSION=1
# Separate key for the email/phone lookup index (base64 of 32 random bytes).
PII_LOOKUP_KEY=replace-with-base64-32-bytes
