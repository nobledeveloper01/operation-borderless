# HTTP port the API listens on.
PORT=3000
# development, test or production.
NODE_ENV=development
# Log level: fatal, error, warn, info, debug.
LOG_LEVEL=info

# PostgreSQL connection (docker compose sets these for the api service).
DB_HOST=localhost
DB_PORT=5432
DB_NAME=borderless
DB_USER=borderless
# Local placeholder only. Use a real secret anywhere shared.
DB_PASSWORD=change-me

# FX provider (no key needed).
FX_PROVIDER_URL=https://open.er-api.com/v6/latest/USD
# How often to refresh rates, in minutes.
FX_REFRESH_MINUTES=60
# Oldest live snapshot allowed for pricing before the fallback table is used, in hours.
FX_MAX_AGE_HOURS=48
# Provider request timeout, in milliseconds.
FX_TIMEOUT_MS=3000

# Comma-separated browser origins allowed by CORS. Empty means CORS is off.
CORS_ORIGINS=
# Requests per minute per IP.
RATE_LIMIT_PER_MINUTE=120
