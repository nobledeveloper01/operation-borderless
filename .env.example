# HTTP port the API listens on.
PORT=3000
# development, test or production.
NODE_ENV=development
# Log level: fatal, error, warn, info, debug.
LOG_LEVEL=info

# PostgreSQL connection (docker compose sets these for the api service).
# TLS to the database: disable, require or verify-full (verify-full required in production).
DB_SSL=disable
# CA certificate file for verify-full.
DB_SSL_CA=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=borderless
DB_USER=borderless
# Local placeholder only. Use a real secret anywhere shared.
DB_PASSWORD=change-me

# FX sources (no keys needed). Primary first, secondary if it fails.
FX_PRIMARY_URL=https://open.er-api.com/v6/latest/USD
FX_SECONDARY_URL=https://latest.currency-api.pages.dev/v1/currencies/usd.json
# Rates older than this, from the provider's update time, never price swaps or transfers.
FX_MAX_DATA_AGE_HOURS=26
# Provider request timeout, in milliseconds.
FX_TIMEOUT_MS=3000
# Use the built-in fixed table when both live sources fail (offline demos only).
FX_FIXED_TABLE=false
# Fetch rates in the background (false in tests, which inject fake providers).
FX_REFRESH_ENABLED=true

# Fee on swaps and cross-currency transfers, in basis points (50 = 0.5%, at most 1000).
# Same-currency transfers and deposits are always free.
FEE_BPS=50
# Per-direction overrides, for example cNGN:cGHS=25,USDx:EURx=0. Empty uses FEE_BPS everywhere.
FEE_BPS_BY_PAIR=
# How long a quote holds its rate and fee, in seconds (5 to 300).
QUOTE_TTL_SECONDS=30

# Folder of ES256 private keys named <kid>.pem (git-ignored). Development makes one on first start.
JWT_KEYS_DIR=./keys/jwt
# Key ID that signs new access tokens.
JWT_ACTIVE_KID=dev-1
# Token issuer and audience checked on every request.
JWT_ISSUER=borderless
JWT_AUDIENCE=borderless-api
# Access-token lifetime, in minutes.
JWT_ACCESS_MINUTES=15
# Refresh-token lifetime, in days.
REFRESH_TOKEN_DAYS=30
# A session ends this many days after login, however often it is refreshed.
SESSION_MAX_DAYS=90
# Sign-up, login and refresh attempts per minute per IP.
AUTH_RATE_LIMIT_PER_MINUTE=10
# Deposits, swaps and transfers per minute per IP.
MONEY_RATE_LIMIT_PER_MINUTE=30
# Wrong passwords in a row before an account locks, and for how many minutes.
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15

# Comma-separated browser origins allowed by CORS. Empty means CORS is off.
CORS_ORIGINS=
# Operator token for /api/v1/ops (metrics, ledger check), sent as X-Ops-Token. At least 32
# characters; empty hides those routes. Production refuses a value that starts with local-.
OPS_TOKEN=local-ops-token-for-the-compose-stack-only
# Requests per minute per IP.
RATE_LIMIT_PER_MINUTE=120
# Trust one proxy hop for the client IP (true behind the compose proxy).
TRUST_PROXY=false

# Ports the compose HTTPS proxy publishes, and the address it binds (127.0.0.1 = this machine only).
BIND_ADDRESS=127.0.0.1
HTTPS_PORT=8443
HTTP_PORT=8080

# Email and phone encryption keys as version:base64 of 32 random bytes, comma-separated.
# These two are local-only values; production refuses them. Make real ones with: openssl rand -base64 32
PII_ENCRYPTION_KEYS=1:bG9jYWwtcGlpLWVuY3J5cHRpb24ta2V5LXYxLTAwMDE=
# Key version used for new writes.
PII_ACTIVE_KEY_VERSION=1
# Separate key for the email and phone lookup index.
PII_LOOKUP_KEY=bG9jYWwtcGlpLWxvb2t1cC1rZXktZm9yLWRldi0wMDA=
