{
	auto_https disable_redirects
	admin off
}

http:// {
	redir https://{host}:{$HTTPS_PORT}{uri} permanent
}

https:// {
	tls internal {
		on_demand
		protocols tls1.2 tls1.3
	}
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
	# Reused connections to the API: closed after 30 s idle, before the API's own 65 s, and enough
	# of them kept that 1,000 clients at once don't run the proxy out of local ports.
	reverse_proxy api:3000 {
		transport http {
			keepalive 30s
			keepalive_idle_conns 2048
			keepalive_idle_conns_per_host 2048
		}
	}
}
